<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.github</groupId>
	<artifactId>tutorial-about-java-60</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!--
		`liquibase.version` itself is managed by the Spring Boot parent BOM.
		Only the Hibernate extension needs a pinned version here.
		-->
		<liquibase-hibernate.version>5.0.3</liquibase-hibernate.version>
		<!--
		Single formatted-SQL changelog.
		`diff` appends new changesets here
		and Spring Boot applies them on startup.

		An SQL «master» file that understands/supports `include` or `includeAll`s directives targeting other files
		is a feature of Liquibase Pro.
		If Liquibase Community is used,
		then the only option for keeping the project "pure SQL" is one growing SQL «master» file.

		The "double" suffix tells the diff serializer which SQL dialect to emit.
		-->
		<liquibase.changelog>db/changelog/db.changelog-master.mysql.sql</liquibase.changelog>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!--
		No longer does Spring Boot 4 auto-configure Liquibase from the raw `liquibase-core`;
		the following is required to run migrations at application startup.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-liquibase</artifactId>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
			How to author migration scripts as part of (code) development.

			Liquibase diffs databases (not Java code), so:
			- target (url)			= 	the real MySQL database
			- source (referenceUrl) = 	the JPA/Hibernate entity metadata,
										read from the compiled `@Entity` classes
										by the `liquibase-hibernate` extension

			`liquibase:diff` then writes the SQL changelog needed to make the database match the JPA entities.
			-->
			<plugin>
				<groupId>org.liquibase</groupId>
				<artifactId>liquibase-maven-plugin</artifactId>
				<version>${liquibase.version}</version>
				<configuration>
					<!--
					The following specifies the changelog, which gets applied by `liquibase:update` and Spring Boot on startup.
					-->
					<!-- <changeLogFile>${liquibase.changelog}</changeLogFile> -->

					<!--
					The following specifies the target: the real database.
					-->
					<url>${env.SPRING_DATASOURCE_URL}</url>
					<username>${env.SPRING_DATASOURCE_USERNAME}</username>
					<password>${env.SPRING_DATASOURCE_PASSWORD}</password>
					<driver>com.mysql.cj.jdbc.Driver</driver>

					<!--
					The following specifies the source: the JPA entities.
					-->
					<referenceUrl>hibernate:spring:com.github.tutorial_about_java_60?dialect=org.hibernate.dialect.MySQLDialect
						&amp;hibernate.physical_naming_strategy=org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy
						&amp;hibernate.implicit_naming_strategy=org.springframework.boot.hibernate.SpringImplicitNamingStrategy
					</referenceUrl>

					<!--
					`liquibase:diff` appends the entities-vs-DB delta to the same changelog.
					-->
					<!-- <diffChangeLogFile>${liquibase.changelog}</diffChangeLogFile> -->
				</configuration>
				<dependencies>	
					<!--
					The following lets Liquibase treat the JPA/Hibernate entity metadata as a database.
					-->
					<dependency>
						<groupId>org.liquibase.ext</groupId>
						<artifactId>liquibase-hibernate7</artifactId>
						<version>${liquibase-hibernate.version}</version>
					</dependency>
					<!--
					`hibernate:spring:` scans the entity package via Spring,
					so the Spring classes must live on the plugin's own classpath
					(versions are inherited from the Spring Boot BOM).
					-->
					<dependency>
						<groupId>org.springframework</groupId>
						<artifactId>spring-context</artifactId>
						<version>${spring-framework.version}</version>
					</dependency>
					<dependency>
						<groupId>org.springframework</groupId>
						<artifactId>spring-orm</artifactId>
						<version>${spring-framework.version}</version>
					</dependency>
					<!--
					JDBC plugin for connecting to the target database.
					-->
					<dependency>
						<groupId>com.mysql</groupId>
						<artifactId>mysql-connector-j</artifactId>
						<version>${mysql.version}</version>
					</dependency>
					<dependency>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-hibernate</artifactId>
						<version>${project.parent.version}</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

</project>
